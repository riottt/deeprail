#!/usr/bin/env python3
from pathlib import Path
import zipfile, hashlib, json, re, subprocess
ROOT=Path(__file__).resolve().parents[1]
status=subprocess.run(["git","-C",str(ROOT),"status","--porcelain","--untracked-files=all"],capture_output=True,text=True,check=True)
if status.stdout.strip(): raise SystemExit("release distribution requires a clean Git worktree")
subprocess.run([str(ROOT/"scripts/generate")],check=True)
subprocess.run([str(ROOT/"scripts/check")],check=True)
out=ROOT/".artifacts"/"dist"; out.mkdir(parents=True,exist_ok=True)
pyproject=(ROOT/"pyproject.toml").read_text(encoding="utf-8")
match=re.search(r'^version\s*=\s*"([^"]+)"',pyproject,re.MULTILINE)
if not match: raise SystemExit("version not found in pyproject.toml")
version=match.group(1); zpath=out/f"deeprail-{version}.zip"
exclude={".git",".artifacts",".venv","__pycache__","参考資料","build","dist",".pytest_cache",".mypy_cache",".ruff_cache",".tox","node_modules"}
def included(p):
    rel=p.relative_to(ROOT)
    if any(part in exclude for part in rel.parts): return False
    if p.suffix==".pyc": return False
    if any(part.endswith(".egg-info") for part in rel.parts): return False
    return p.is_file()
tracked=subprocess.run(["git","-C",str(ROOT),"ls-files","-z"],capture_output=True,check=True).stdout.split(b"\0")
tracked_paths=[ROOT/Path(raw.decode("utf-8")) for raw in tracked if raw]
with zipfile.ZipFile(zpath,"w",zipfile.ZIP_DEFLATED,compresslevel=9) as z:
    for p in sorted(tracked_paths):
        if included(p): z.write(p,Path(f"deeprail-{version}")/p.relative_to(ROOT))
sha=hashlib.sha256(zpath.read_bytes()).hexdigest()
(zpath.with_suffix(".zip.sha256")).write_text(f"{sha}  {zpath.name}\n",encoding="utf-8")
manifest={"version":version,"tag":f"v{version}","archive":zpath.name,"sha256":sha,"status":"released","public_release":True}
(out/"release-manifest.json").write_text(json.dumps(manifest,indent=2)+"\n",encoding="utf-8")
print(zpath)
