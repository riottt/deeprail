#!/usr/bin/env python3
from pathlib import Path
import json, yaml, subprocess, sys, hashlib
ROOT=Path(__file__).resolve().parents[1]
subprocess.run([str(ROOT/"scripts/sync-resources")],check=True)
wf=[]
for p in sorted((ROOT/"workflows").glob("*/workflow.yaml")):
    data=yaml.safe_load(p.read_text(encoding="utf-8"))
    wf.append({"id":data["id"],"path":str(p.relative_to(ROOT)),"module_refs":data.get("module_refs",[]),"next":data.get("next",[]),"evidence_policy":data.get("evidence_policy",{})})
generated=ROOT/".deeprail"/"generated"; generated.mkdir(parents=True,exist_ok=True)
(generated/"workflow-index.json").write_text(json.dumps({"workflows":wf},ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
repo=json.loads((ROOT/".deeprail/manifests/repository.json").read_text(encoding="utf-8")); modules=json.loads((ROOT/".deeprail/manifests/content.json").read_text(encoding="utf-8"))["modules"]
text=["<!-- Generated by ./scripts/generate. Do not edit directly. -->","# DeepRail Repository Map","",f"- Phase: `{repo['repository']['phase']}`",f"- Candidate version: `{repo['repository']['candidate_version']}`",f"- Release: `{repo['repository']['release_status']}`",f"- Modules: `{len(modules)}`",f"- Workflows: `{len(wf)}`","- Creator / Lead Author: **RIO AMADA**","","## Entry points","- Book: `book/ja/chapters/README.md`","- Quickstart: `docs/ja/quickstart.md`","- Diagnostic: `docs/ja/diagnostic.md`","- Standard: `standard/README.md`","- Workflows: `workflows/README.md`"]
(generated/"repository-map.md").write_text("\n".join(text)+"\n",encoding="utf-8")
# Traceability generated snapshot
trace=yaml.safe_load((ROOT/"maps/traceability.yaml").read_text(encoding="utf-8"))
(generated/"traceability.json").write_text(json.dumps(trace,ensure_ascii=False,indent=2)+"\n",encoding="utf-8")
print("generated")
