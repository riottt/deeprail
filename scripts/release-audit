#!/usr/bin/env python3
from pathlib import Path
import subprocess, sys, tempfile, shutil, os, json, zipfile
ROOT=Path(__file__).resolve().parents[1]

def run(cmd, cwd=ROOT, env=None):
    print('+', ' '.join(map(str,cmd)))
    subprocess.run(list(map(str,cmd)),cwd=cwd,env=env,check=True)

run([ROOT/'scripts/generate'])
run([ROOT/'scripts/check'])
run([sys.executable,'-m','unittest','discover','-s','tests','-v'])
with tempfile.TemporaryDirectory() as td:
    td=Path(td); wheel_dir=td/'wheel'; install_dir=td/'install'; project=td/'project'
    wheel_dir.mkdir(); install_dir.mkdir(); project.mkdir()
    run([sys.executable,'-m','pip','wheel','.', '--no-deps','--no-build-isolation','-w',wheel_dir])
    wheel=next(wheel_dir.glob('*.whl'))
    run([sys.executable,'-m','pip','install','--no-deps','--target',install_dir,wheel])
    env=os.environ.copy(); env['PYTHONPATH']=str(install_dir)
    run([sys.executable,'-m','deeprail_runtime.cli','version'],cwd=td,env=env)
    run([sys.executable,'-m','deeprail_runtime.cli','init','--target',project,'--profile','lightweight','--communication','ja','--artifacts','en','--adapter','generic'],cwd=td,env=env)
    run([sys.executable,'-m','deeprail_runtime.cli','doctor','--project',project],cwd=td,env=env)
print('DeepRail release audit: PASS')
