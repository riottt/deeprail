{
  "standard_version_strategy": "single-version",
  "primary_authoring_language": "ja",
  "official_projection_languages": [
    "ja",
    "en"
  ],
  "projection_statuses": [
    "synced",
    "reviewing",
    "outdated",
    "missing"
  ],
  "release_policy": {
    "formal_release_languages": [
      "ja"
    ],
    "preview_projection_languages": [
      "en"
    ],
    "required_synced_languages": [
      "ja"
    ],
    "allow_incomplete_when_release_status": [
      "released"
    ],
    "incomplete_language_rule": "Only explicitly declared preview_projection_languages may remain missing in a released version."
  }
}
